{
  // TestFlow TCM — enterprise installer configuration
  appId: "com.testflow.tcm",
  productName: "TestFlow TCM",
  copyright: "Copyright © 2025 TestFlow",
  asar: true,

  directories: {
    buildResources: "resources",
    output: "dist",
  },

  files: [
    "out/**/*",
    "!out/renderer/**/*.{map,txt}",
  ],

  // Include the bundled NestJS backend for local-mode operation
  // Include playwright npm packages (CLI + core) so codegen and test execution work
  // without the user needing to install Node.js or playwright globally.
  // The Electron runtime (ELECTRON_RUN_AS_NODE=1) executes the playwright CLI JS directly.
  // Browsers are NOT bundled — users install them separately via: npx playwright install chromium
  extraResources: [
    {
      from: "resources/backend",
      to: "backend",
      filter: ["**/*"],
    },
    {
      from: "../node_modules/@playwright/test",
      to: "playwright/node_modules/@playwright/test",
      filter: ["**/*", "!**/*.map"],
    },
    {
      from: "../node_modules/playwright",
      to: "playwright/node_modules/playwright",
      filter: ["**/*", "!**/*.map"],
    },
    {
      from: "../node_modules/playwright-core",
      to: "playwright/node_modules/playwright-core",
      filter: ["**/*", "!**/*.map"],
    },
  ],

  // ─── Windows ───────────────────────────────────────────────────────────────
  win: {
    target: [
      { target: "nsis", arch: ["x64", "ia32"] },
      { target: "portable", arch: ["x64"] },
    ],
    icon: "resources/icon.ico",
    publisherName: "TestFlow",
    verifyUpdateCodeSignature: false,
    requestedExecutionLevel: "asInvoker",
  },

  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    allowElevation: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "TestFlow TCM",
    installerIcon: "resources/icon.ico",
    uninstallerIcon: "resources/icon.ico",
    runAfterFinish: true,
    deleteAppDataOnUninstall: false,
  },

  // ─── macOS ─────────────────────────────────────────────────────────────────
  mac: {
    target: [
      { target: "dmg", arch: ["x64", "arm64"] },
      { target: "zip", arch: ["x64", "arm64"] },
    ],
    icon: "resources/icon.icns",
    category: "public.app-category.developer-tools",
    darkModeSupport: true,
    hardenedRuntime: true,
    gatekeeperAssess: false,
    entitlements: "resources/entitlements.mac.plist",
    entitlementsInherit: "resources/entitlements.mac.plist",
    notarize: false, // set to true + configure after obtaining Apple Developer account
  },

  dmg: {
    icon: "resources/icon.icns",
    iconSize: 80,
    window: { width: 660, height: 400 },
    contents: [
      { x: 190, y: 200, type: "file" },
      { x: 470, y: 200, type: "link", path: "/Applications" },
    ],
  },

  // ─── Linux ─────────────────────────────────────────────────────────────────
  linux: {
    target: [
      { target: "AppImage", arch: ["x64"] },
      { target: "deb", arch: ["x64"] },
      // rpm requires rpmbuild — only build on Linux CI. Run: brew install rpm on macOS first.
    ],
    icon: "resources/icons",
    category: "Development",
    description: "Enterprise Test Case Management Platform",
    desktop: {
      StartupNotify: "true",
      Categories: "Development;",
    },
  },

  deb: {
    depends: ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libdrm2", "libgbm1"],
  },

  // ─── Auto-Update ───────────────────────────────────────────────────────────
  // GitHub Releases — set GH_TOKEN env var before running dist:*
  // RELEASE_GH_TOKEN (read-only, Contents+Metadata) is injected by the release
  // script via --config.publish.token so it ends up in app-update.yml inside the app.
  publish: {
    provider: "github",
    owner: "sandeepdillerao",
    repo: "swift-test-suite",
    releaseType: "release",
    // private: true tells electron-updater to use the authenticated GitHub API
    // (api.github.com/repos/.../releases) instead of the direct download URL
    // (github.com/.../releases/latest/download) which returns 404 for private repos.
    private: true,
  },

  // ─── Protocol handler (deep links) ─────────────────────────────────────────
  protocols: {
    name: "testflow",
    schemes: ["testflow"],
  },
}
