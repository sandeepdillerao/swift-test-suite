# ========================================================
# TestFlow TCM - Production env (for docker-compose.prod.yml)
# Copy to .env, then edit the REQUIRED values below.
# ========================================================

# --- Required: change these secrets! ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32-chars

# --- Image version (matches the tag produced by build-and-package.sh) ---
IMAGE_TAG=1.0.0

# --- App ---
APP_PORT=8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
SWAGGER_ENABLED=true

# --- Database (internal to docker network) ---
DB_USERNAME=testflow
DB_PASSWORD=testflow_secret
DB_NAME=testflow_db
# On first boot, keep DB_SYNC=true so tables auto-create. Set to false once seeded.
DB_SYNC=true

# --- JWT expiries ---
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Redis (leave empty for no password) ---
REDIS_PASSWORD=

# --- Crypto ---
BCRYPT_ROUNDS=12
