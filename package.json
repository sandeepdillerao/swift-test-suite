{
  "name": "testflow-tcm",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "npm install --prefix electron",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:electron": "concurrently --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:backend\" \"wait-on http://localhost:5173 && npm run dev --prefix electron\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:electron": "npm run build --prefix electron",
    "dist:win": "npm run dist:win --prefix electron",
    "dist:mac": "npm run dist:mac --prefix electron",
    "dist:linux": "npm run dist:linux --prefix electron",
    "dist:all": "npm run dist:all --prefix electron",
    "release": "cd electron && bash scripts/release.sh",
    "release:dry": "cd electron && bash scripts/release.sh --dry-run",
    "test:backend": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^9.0.10"
  }
}
